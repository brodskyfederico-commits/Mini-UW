    "annual_service_convention": {
      "enum": [
        "m_times_regular_payment_equivalent",
        "dated_or_unresolved"
      ]
    },
    "annual_service_evidence_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
