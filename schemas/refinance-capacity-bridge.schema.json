    "valuation_cap_rate",
    "bank_underwriting_noi",
    "maximum_ltv",
    "minimum_bank_dscr",
    "periodic_effective_rate",
    "amortization_payment_count",
    "payments_per_year",
    "maturity_after_payment_count",
    "selected_principal",
    "other_capacity_limits",
    "calculation_budget_payments",
    "annual_service_convention",
    "annual_service_evidence_ref"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miniuw:candidate:refinance-capacity-bridge:0.1",
  "title": "Declared valuation/fixed-amortization/bank-capacity/selected-principal/closing reference; not credit approval"
