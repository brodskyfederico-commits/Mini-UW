{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miniuw:candidate:M3:0.1",
  "title": "M3 candidate interface (structure only)",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1-candidate"
    },
    "purpose": {
      "const": "design_or_synthetic_reference"
    },
    "module": {
      "const": "M3"
    },
    "context": {
      "$ref": "urn:miniuw:candidate:common:0.1#/$defs/context"
    },
    "status": {
      "enum": [
        "candidate_complete",
        "blocked",
        "not_applicable"
      ]
    },
    "pending_causes": {
      "type": "array",
      "items": {
        "$ref": "urn:miniuw:candidate:common:0.1#/$defs/cause"
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "budget_before_financing": {
          "$ref": "urn:miniuw:candidate:common:0.1#/$defs/quantity"
        },
        "unallocated_scope_cost": {
          "$ref": "urn:miniuw:candidate:common:0.1#/$defs/quantity"
        }
      },
      "required": [
        "budget_before_financing",
        "unallocated_scope_cost"
      ],
      "additionalProperties": false
    },
    "authorization": {
      "const": "not_granted"
    }
  },
  "required": [
    "schema_version",
    "purpose",
    "module",
    "context",
    "status",
    "pending_causes",
    "outputs",
    "authorization"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "pending_causes": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
