{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miniuw:candidate:M9:0.1",
  "title": "M9 candidate interface (structure only)",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1-candidate"
    },
    "purpose": {
      "const": "design_or_synthetic_reference"
    },
    "module": {
      "const": "M9"
    },
    "context": {
      "$ref": "urn:miniuw:candidate:common:0.1#/$defs/context"
    },
    "status": {
      "enum": [
        "candidate_complete",
        "blocked",
        "not_applicable"
      ]
    },
    "pending_causes": {
      "type": "array",
      "items": {
        "$ref": "urn:miniuw:candidate:common:0.1#/$defs/cause"
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "aggregation_rule_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric_id": {
                "type": "string",
                "minLength": 1
              },
              "criterion_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "result": {
                "enum": [
                  "satisfies_pass_condition",
                  "crosses_fail_condition",
                  "band",
                  "conflict",
                  "not_applicable",
                  "not_evaluable"
                ]
              },
              "applicability_reason": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "applicability_rule_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            },
            "required": [
              "metric_id",
              "criterion_ref",
              "result",
              "applicability_reason",
              "applicability_rule_ref"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "result": {
                      "const": "not_applicable"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "applicability_reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "applicability_rule_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "required": [
        "decision",
        "aggregation_rule_ref",
        "comparisons"
      ],
      "additionalProperties": false
    },
    "authorization": {
      "const": "not_granted"
    }
  },
  "required": [
    "schema_version",
    "purpose",
    "module",
    "context",
    "status",
    "pending_causes",
    "outputs",
    "authorization"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "pending_causes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "outputs": {
            "properties": {
              "decision": {
                "const": "PENDING"
              }
            }
          }
        }
      }
    }
  ]
}
