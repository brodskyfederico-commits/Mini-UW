{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miniuw:candidate:criterion:0.1",
  "title": "criterion candidate record shape only",
  "type": "object",
  "properties": {
    "criterion_id": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "$ref": "urn:miniuw:candidate:common:0.1#/$defs/context"
    },
    "metric_id": {
      "type": "string",
      "minLength": 1
    },
    "metric_definition_ref": {
      "type": "string",
      "minLength": 1
    },
    "condition_role": {
      "enum": [
        "pass_condition",
        "fail_condition"
      ]
    },
    "operator": {
      "enum": [
        ">=",
        ">",
        "<=",
        "<"
      ]
    },
    "threshold": {
      "$ref": "urn:miniuw:candidate:common:0.1#/$defs/quantity"
    },
    "applicability": {
      "enum": [
        "applicable",
        "excluded",
        "unresolved"
      ]
    },
    "applicability_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "applicability_rule_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "aggregation_rule_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:miniuw:candidate:common:0.1#/$defs/source"
      }
    },
    "purpose": {
      "const": "design_or_synthetic_reference"
    },
    "authorization": {
      "const": "not_granted"
    }
  },
  "required": [
    "criterion_id",
    "context",
    "metric_id",
    "metric_definition_ref",
    "condition_role",
    "operator",
    "threshold",
    "applicability",
    "applicability_reason",
    "applicability_rule_ref",
    "aggregation_rule_ref",
    "sources",
    "purpose",
    "authorization"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "applicability": {
            "const": "excluded"
          }
        }
      },
      "then": {
        "properties": {
          "applicability_reason": {
            "type": "string",
            "minLength": 1
          },
          "applicability_rule_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
