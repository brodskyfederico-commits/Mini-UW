  "rules": [
    {
      "id": "MI-01",
      "definition": "Separar valor de métrica aportado, criterio de inversión, condición bancaria y resultado calculado propio.",
      "sources": [
        "D02-VALUES",
        "INPUT-FIELDS"
      ]
    },
    {
      "id": "MI-02",
      "definition": "Vincular cada afirmación a archivo original/hash, revisión, hoja/celda o ubicación, literal y rol explícito.",
      "sources": [
        "M1-NORMALIZE"
      ]
    },
    {
      "id": "MI-03",
      "definition": "Mapear etiquetas a IDs sólo mediante perfil de mapeo versionado y explícito; duplicados no se sobrescriben.",
      "sources": [
        "M1-STATES",
        "METRIC-CATALOG"
      ]
    },
    {
      "id": "MI-04",
      "definition": "Exigir definición, unidad, escala, moneda si aplica, período/cutoff, escenario y alcance compatibles.",
      "sources": [
        "M9-COMPARE"
      ]
    },
    {
      "id": "MI-05",
      "definition": "Un perfil de interpretación explícito distingue fracción, porcentaje, puntos porcentuales y bps; ni símbolo ni rango típico deciden.",
      "sources": [
        "M1-NORMALIZE"
      ]
    },
    {
      "id": "MI-06",
      "definition": "Conservar cero, vacío, inválido, conflicto, indefinido y no aplicable justificado como estados distintos.",
      "sources": [
        "M1-STATES"
      ]
    },
    {
      "id": "MI-07",
      "definition": "Inventariar métricas/escenarios requeridos y aplicabilidad con evidencia; vacíos no heredan otro deal o escenario.",
      "sources": [
        "INPUT-COMPLETE",
        "INPUT-FIELDS"
      ]
    },
    {
      "id": "MI-08",
      "definition": "Criterios nuevos por deal sin números históricos; cada condición incluye operador, umbral, igualdad y fuente.",
      "sources": [
        "INPUT-FIELDS"
      ]
    },
    {
      "id": "MI-09",
      "definition": "Registrar y resolver discrepancias sin preferencia por autor, nombre de archivo o última fecha; igualdad no acredita independencia.",
      "sources": [
        "M1-STATES",
        "D02-VALUES"
      ]
    },
    {
      "id": "MI-10",
      "definition": "Fórmula, error o enlace externo en la entrada no es un literal utilizable por su caché; no ejecutar fórmulas ni macros.",
      "sources": [
        "M1-NORMALIZE"
      ]
    },
    {
      "id": "MI-11",
      "definition": "Recalcular versiones afectadas y comparaciones bajo una misma instantánea; correcciones conservan la afirmación original.",
      "sources": [
        "D02-REVISIONS"
      ]
    },
    {
      "id": "MI-12",
      "definition": "Faltantes/conflictos requeridos o banda intermedia conservan PENDING antes de emitir dictamen completo.",
      "sources": [
        "M9-COMPLETE",
        "USER-BAND"
      ]
    },
    {
      "id": "MI-13",
      "definition": "Conservar cada bloqueo con afirmación, ubicación, dependencia y evidencia necesaria para resolverlo.",
      "sources": [
        "INPUT-COMPLETE",
        "M1-STATES"
      ]
    },
    {
      "id": "MI-14",
      "definition": "Completar la entrada no autentica al revisor ni habilita publicación o decisiones reales.",
      "sources": [
        "D02-VALUES",
        "D02-REVISIONS"
      ]
    }
  ],
