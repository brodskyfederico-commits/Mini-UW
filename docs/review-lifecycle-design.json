  "rules": [
    {
      "id": "RD-01",
      "definition": "Conservar la fuente y el candidato originales; cada cambio produce otro candidato con padre y diff explícitos.",
      "sources": [
        "T13-BRANCH"
      ]
    },
    {
      "id": "RD-02",
      "definition": "Vincular el candidato a deal, run, escenarios y revisiones de fuentes, definiciones, criterios, reglas y manifiesto de dependencias.",
      "sources": [
        "M9-REVISION"
      ]
    },
    {
      "id": "RD-03",
      "definition": "Comprobar revisión monotónica del contexto además de hashes para rechazar A→B→A y contexto obsoleto.",
      "sources": [
        "M9-ATOMIC"
      ]
    },
    {
      "id": "RD-04",
      "definition": "Evaluar completitud de todo lo requerido antes de clasificar; ningún aprobado:true ni incumplimiento conocido elimina faltantes.",
      "sources": [
        "M9-COMPLETE"
      ]
    },
    {
      "id": "RD-05",
      "definition": "Conservar banda intermedia PENDING; no optimizar variables para cambiar el resultado.",
      "sources": [
        "USER-BAND",
        "T13-BRANCH"
      ]
    },
    {
      "id": "RD-06",
      "definition": "Una revisión sólo puede usarse con identidad autenticada, autoridad acreditada, alcance exacto, evidencia y vigencia verificables.",
      "sources": [
        "M9-AUTH"
      ]
    },
    {
      "id": "RD-07",
      "definition": "Expiración, revocación o cambio de alcance impiden usar la revisión en una nueva publicación; una renovación crea evidencia nueva.",
      "sources": [
        "M9-RETRY"
      ]
    },
    {
      "id": "RD-08",
      "definition": "Preparar PDF y resultados sobre un manifiesto inmutable; el registro de decisión vigente, control de revisión y recibo local deben ser una única transacción.",
      "sources": [
        "M9-ATOMIC",
        "M9-PDF"
      ]
    },
    {
      "id": "RD-09",
      "definition": "Reintento con misma identidad y contenido devuelve mismo recibo; misma identidad con contenido diferente se rechaza.",
      "sources": [
        "M9-RETRY"
      ]
    },
    {
      "id": "RD-10",
      "definition": "La entrega externa es un efecto distinto del commit local. Sin garantías de vigencia en el destino, no afirmar publicación distribuida atómica.",
      "sources": [
        "M9-ATOMIC"
      ]
    },
    {
      "id": "RD-11",
      "definition": "Retirar o sustituir una propuesta no borra evidencia ni retira por sí solo una publicación ya entregada.",
      "sources": [
        "T13-BRANCH",
        "M9-RETRY"
      ]
    },
    {
      "id": "RD-12",
      "definition": "PASS de screening no autoriza inversión ni acceso automático a Full UW; conservar puerta de revisión final aplicable y vigente.",
      "sources": [
        "M9-FULL"
      ]
    },
    {
      "id": "RD-13",
      "definition": "Reusar caja sólo con independencia acreditada; cambios de criterios invalidan comparaciones y precios dependientes.",
      "sources": [
        "M9-REVISION"
      ]
    },
    {
      "id": "RD-14",
      "definition": "Mantener fuente de métricas aportadas separada de productor financiero propio; T13 sólo reevalúa comparaciones.",
      "sources": [
        "T13-LIMIT"
      ]
    },
    {
      "id": "RD-15",
      "definition": "Fallo o incertidumbre al consultar vigencia/identidad/revocación bloquea promoción; no se usa una última respuesta positiva como permiso.",
      "sources": [
        "M9-AUTH",
        "M9-ATOMIC"
      ]
    }
  ],
